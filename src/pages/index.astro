---
import Layout from "../layouts/Layout.astro";

import Dashboard from "../components/Dashboard";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import ItemListSchema from "../components/schema/ItemListSchema.astro";
import { getWebMCPSites } from "../utils/webmcp";

const allSites = getWebMCPSites().map((site) => ({
  title: site.name,
  body: `WebMCP: ${site.webmcp.type} · ${site.webmcp.status}`,
  url: site.url,
}));
---

<Layout
  site="WebMCP Directory"
  title="WebMCP Directory"
  tagline="WebMCP websites curated for discovery and verification"
  showSearch={true}
>
  <OrganizationSchema />
  <ItemListSchema items={allSites} listName="WebMCP Websites Directory" />
  <main id="main-content">
    <Dashboard client:load category="all" transition:persist />
  </main>
</Layout>
