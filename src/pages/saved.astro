---
import Layout from "../layouts/Layout.astro";
import FavoritesView from "../components/FavoritesView";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";

const breadcrumbs = [
    { name: "Home", url: Astro.site?.toString() || "/" },
    { name: "Saved websites" },
];
---

<Layout
    site="WebMCP Directory - Saved websites"
    title="Saved websites"
    tagline="Websites you've saved for quick access"
    pageTitle="Saved websites"
    pageDescription="Your saved WebMCP websites collection"
>
    <BreadcrumbSchema items={breadcrumbs} />
    <main id="main-content">
        <FavoritesView client:load />
    </main>
</Layout>
