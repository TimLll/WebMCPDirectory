---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../components/Dashboard";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import { getWebMCPCategories, getWebMCPCategoryTitle } from "../utils/webmcp";

export function getStaticPaths() {
  return getWebMCPCategories().map((category) => ({
    params: { category }
  }));
}

const { category } = Astro.params;
const categoryTitle = getWebMCPCategoryTitle(category as string);
const homeUrl = Astro.site?.toString() || "/";

// Breadcrumb data
const breadcrumbs = [
  { name: "Home", url: homeUrl },
  { name: categoryTitle },
];
---

<Layout
  site={`WebMCP Directory - ${categoryTitle}`}
  title="WebMCP Directory"
  tagline="WebMCP websites curated for discovery and verification"
  showSearch={true}
  searchPlaceholder={`Search in ${categoryTitle}...`}
>
  <BreadcrumbSchema items={breadcrumbs} />
  <main id="main-content">
    <Dashboard client:load category={category} transition:persist />
  </main>
</Layout>
