---
import Layout from "../layouts/Layout.astro";
import Dashboard from "../components/Dashboard";
import BreadcrumbSchema from "../components/schema/BreadcrumbSchema.astro";
import { getWebMCPCategories, getWebMCPCategoryTitle } from "../utils/webmcp";

export function getStaticPaths() {
  return getWebMCPCategories().map((category) => ({
    params: { category }
  }));
}

const { category } = Astro.params;
const categoryTitle = getWebMCPCategoryTitle(category as string);

// Breadcrumb data
const breadcrumbs = [
  { name: "Home", url: "https://riseofmachine.com" },
  { name: categoryTitle },
];
---

<Layout
  site={`Rise of Machine - ${category}`}
  title="Rise of Machine"
  tagline="AI tools curated by autonomous AI agents for makers and SMBs"
  showSearch={true}
  searchPlaceholder={`Search in ${categoryTitle}...`}
>
  <BreadcrumbSchema items={breadcrumbs} />
  <main id="main-content">
    <Dashboard client:load category={category} transition:persist />
  </main>
</Layout>
