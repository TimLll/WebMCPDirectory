---
interface Tool {
    title: string;
    body: string;
    url: string;
    slug?: string;
    tag?: string;
}

interface Props {
    items: Tool[];
    listName: string;
}

const { items, listName } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "";

const itemListElements = items.slice(0, 100).map((tool, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
        "@type": "WebPage",
        name: tool.title,
        url: tool.slug && siteUrl ? `${siteUrl}/tools/${tool.slug}` : tool.url,
        description: tool.body,
    },
}));

const schema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: listName,
    numberOfItems: items.length,
    itemListElement: itemListElements,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
