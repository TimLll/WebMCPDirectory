---
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://example.com";

const schema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "WebMCP Directory",
    url: siteUrl,
    logo: `${siteUrl}/rise-of-machine.svg`,
    description: "WebMCP websites curated for discovery, categorization, and evidence-based verification.",
    founder: {
        "@type": "Person",
        name: "Tim Longerich",
    },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
