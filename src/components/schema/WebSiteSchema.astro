---
interface Props {
    url?: string;
}

const resolvedSiteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://example.com";
const { url = resolvedSiteUrl } = Astro.props;

const schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "WebMCP Directory",
    url: url,
    description: "WebMCP websites curated for discovery, categorization, and evidence-based verification.",
    potentialAction: {
        "@type": "SearchAction",
        target: {
            "@type": "EntryPoint",
            urlTemplate: `${url}/?search={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
    },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
